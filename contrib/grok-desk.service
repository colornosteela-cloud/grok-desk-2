[Unit]
Description=Grok Desk MiniOS (Grok Build frontend)
After=network-online.target teela-qwen38-27b.service
Wants=network-online.target teela-qwen38-27b.service

[Service]
Type=simple
WorkingDirectory=%h/grok-desk
Environment=HOME=%h
Environment=GROK_BIN=%h/.grok/bin/grok
Environment=GROK_HOME=%h/.grok
Environment=GROK_DESKS=%h/grok-desks
Environment=GROK_DESK_PORT=8742
Environment=GROK_DESK_SANDBOX=off
Environment=GROK_DESK_TEELA=%h/teela
Environment=GROK_DESK_VLLM=http://127.0.0.1:8081
Environment=GROK_DESK_VLLM_MODEL=Qwen3.8-27B
Environment=GROK_DESK_VLLM_MAX_LEN=262144
Environment=GROK_DESK_VLLM_MAX_TOKENS=32768
Environment=PATH=%h/.grok/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 %h/grok-desk/deskd/deskd.py
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
